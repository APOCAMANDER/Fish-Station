<DefaultWindow xmlns="https://spacestation14.io"
                    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                    MouseFilter="Stop"
                    Title="{Loc whitelist-add-window-name}"
                    MinWidth="200">
    <BoxContainer Orientation= "Vertical" Margin="10 0 20 0">
        <!-- USERNAME -->
        <LineEdit
            Name="Username"
            PlaceHolder="Username"
            HorizontalExpand="True"
        />

        <!-- Confirm Button-->
        <controls:ConfirmButton Name="ConfirmButton" Text="{Loc whitelist-add-confirm-button}" />
    </BoxContainer>
</DefaultWindow>
